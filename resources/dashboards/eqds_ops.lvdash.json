{
 "datasets": [
  {
   "name": "checks",
   "displayName": "Seed validation (latest run)",
   "queryLines": [
    "SELECT check_no, check_id, name, passed, actual FROM seed_validation_results WHERE ran_at >= (SELECT max(ran_at) FROM seed_validation_results) - INTERVAL 15 MINUTES AND check_id NOT LIKE 'rowcount:%' ORDER BY check_no"
   ]
  },
  {
   "name": "summary",
   "displayName": "Validation summary",
   "queryLines": [
    "SELECT count_if(passed) AS passed, count_if(NOT passed) AS failed, max(ran_at) AS last_run FROM seed_validation_results WHERE ran_at >= (SELECT max(ran_at) FROM seed_validation_results) - INTERVAL 15 MINUTES"
   ]
  },
  {
   "name": "volumes",
   "displayName": "Row counts",
   "queryLines": [
    "SELECT replace(check_id, 'rowcount:', '') AS dataset, actual AS rows FROM seed_validation_results WHERE ran_at >= (SELECT max(ran_at) FROM seed_validation_results) - INTERVAL 15 MINUTES AND check_id LIKE 'rowcount:%' ORDER BY 1"
   ]
  },
  {
   "name": "index_state",
   "displayName": "Documents by source",
   "queryLines": [
    "SELECT 'broker_chunks' AS source, count(*) AS chunks FROM broker_chunks UNION ALL SELECT 'expert_chunks', count(*) FROM expert_chunks UNION ALL SELECT 'earnings_chunks', count(*) FROM earnings_chunks UNION ALL SELECT 'news_items', count(*) FROM news_items"
   ]
  }
 ],
 "pages": [
  {
   "name": "ops",
   "displayName": "EQDS platform health",
   "pageType": "PAGE_TYPE_CANVAS",
   "layout": [
    {
     "widget": {
      "name": "passed",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "summary",
         "fields": [
          {
           "name": "passed",
           "expression": "`passed`"
          }
         ],
         "disaggregated": true
        }
       }
      ],
      "spec": {
       "version": 2,
       "widgetType": "counter",
       "encodings": {
        "value": {
         "fieldName": "passed",
         "displayName": "Checks passed"
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Checks passed"
       }
      }
     },
     "position": {
